  empresas            empresas? @relation(fields: [id_de_empresa], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "trimestres_ibfk_1")

  @@unique([a_o, num_trimestre, id_de_empresa], map: "unique_trimestre_empresa")
